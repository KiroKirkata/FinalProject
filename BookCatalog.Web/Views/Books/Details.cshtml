@model BookViewModel
@{ ViewData["Title"] = "Book Details"; }
<h1>@Model.Title</h1>
<dl class="row">
    <dt class="col-sm-2">Author</dt><dd class="col-sm-10">@Model.AuthorName</dd>
    <dt class="col-sm-2">Year</dt><dd class="col-sm-10">@Model.Year</dd>
    <dt class="col-sm-2">Price</dt><dd class="col-sm-10">@Model.Price.ToString("C")</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>
