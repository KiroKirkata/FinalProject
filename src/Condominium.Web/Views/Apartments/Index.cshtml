@model IReadOnlyList<ApartmentViewModel>
@{ ViewData["Title"] = "Апартаменти"; }
<h1>Апартаменти</h1>
<p>Достъпни имоти според профила и одобрените връзки.</p>
<div class="table-wrap"><table>
<thead><tr><th>Сграда</th><th>Апартамент</th><th>Брой живущи</th><th>Идеални части</th></tr></thead>
<tbody>@foreach (var row in Model) {
<tr><td>@row.Building</td><td>@row.Number</td><td>@row.ResidentCount</td><td>@row.IdealSharePercent.ToString("0.######")%</td></tr>
}</tbody></table></div>
@if (Model.Count == 0) { <p>Няма достъпни апартаменти.</p> }
