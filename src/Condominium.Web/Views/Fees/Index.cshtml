@model IReadOnlyList<FeeViewModel>
@{ ViewData["Title"] = "Задължения"; }
<h1>Месечни начисления</h1>
<p>Примерни начислени суми. Плащанията се показват отделно; това не е справка за остатъчното задължение.</p>
<div class="table-wrap"><table>
<thead><tr><th>Сграда</th><th>Апартамент</th><th>Период</th><th>Падеж</th><th>Начислена сума</th></tr></thead>
<tbody>@foreach (var row in Model) {
<tr><td>@row.Building</td><td>@row.Apartment</td><td>@row.Period.ToString("MM.yyyy")</td><td>@row.DueDate.ToString("dd.MM.yyyy")</td><td>@row.Amount.ToString("F2") @row.Currency</td></tr>
}</tbody></table></div>
@if (Model.Count == 0) { <p>Няма достъпни начисления.</p> }
