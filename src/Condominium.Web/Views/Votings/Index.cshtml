@model IReadOnlyList<VotingViewModel>
@{ ViewData["Title"] = "Гласувания"; }
<h1>Гласувания</h1>
<p>Преглед на примерни записи. Подаването на вот и изчисляването на резултат предстоят.</p>
<div class="table-wrap"><table>
<thead><tr><th>Сграда</th><th>Тема</th><th>Срок UTC</th><th>Правила</th></tr></thead>
<tbody>@foreach (var row in Model) {
<tr><td>@row.Building</td><td>@row.Title</td><td>@row.ClosesAt.UtcDateTime.ToString("dd.MM.yyyy HH:mm")</td><td>@row.RuleDescription</td></tr>
}</tbody></table></div>
@if (Model.Count == 0) { <p>Няма достъпни гласувания.</p> }
