@model IReadOnlyList<IssueViewModel>
@{ ViewData["Title"] = "Сигнали"; }
<h1>Сигнали</h1>
<p>Начален преглед. Подаването и промяната на статус предстоят.</p>
<div class="table-wrap"><table>
<thead><tr><th>Сграда</th><th>Апартамент</th><th>Заглавие</th><th>Статус</th></tr></thead>
<tbody>@foreach (var row in Model) {
<tr><td>@row.Building</td><td>@row.Apartment</td><td>@row.Title</td><td>@row.Status</td></tr>
}</tbody></table></div>
@if (Model.Count == 0) { <p>Няма достъпни сигнали.</p> }
